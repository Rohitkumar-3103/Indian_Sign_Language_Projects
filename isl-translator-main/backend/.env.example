# Deepgram API key for speech-to-text audio transcription
# Get your free API key at https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Backend server port (changed to 5001 to avoid conflict with main Flask app on 5000)
PORT=5001

# Optional: Path to custom ffmpeg bin directory if not on system PATH
# FFMPEG_PATH=C:\path\to\ffmpeg\bin
